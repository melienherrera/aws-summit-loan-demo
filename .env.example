# ── Local Development ─────────────────────────────────────────────
# Temporal dev server (default for local runs)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ── Temporal Cloud ────────────────────────────────────────────────
# Uncomment and fill in when connecting to Temporal Cloud
# TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=<namespace>
# TEMPORAL_API_KEY=<your-api-key>

# ── AWS Credentials (local development) ──────────────────────────
AWS_REGION=us-west-2

# Option 1: SSO / bearer token (recommended for local dev)
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token

# Option 2: IAM access keys
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Option 3: Named SSO profile
# AWS_PROFILE=your-sso-profile

# ── Crash / Failure Demo ─────────────────────────────────────────
# Scenario 1: Kill worker mid-activity
# Slows down credit_check so you have a window to kill the worker.
# Temporal retries automatically when the worker restarts.
# DEMO_CRASH_DELAY=15

# Scenario 2: Flaky API retry
# Simulates a 429 Too Many Requests from the credit bureau on attempt 1.
# Temporal retries automatically and attempt 2 succeeds.
# DEMO_API_RETRY=true

# ── Lambda Deployment (Serverless Workers) ────────────────────────
# Only needed when building/deploying the Lambda worker (steps 3–11)
# AWS_ACCOUNT_ID=123456789012
# LAMBDA_FUNCTION_NAME=loan-underwriting-worker
# LAMBDA_S3_BUCKET=loan-underwriting-lambda-deploy
# LAMBDA_REGION=us-west-2
