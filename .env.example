# Temporal — local dev server
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Temporal Cloud — set from cloud.temporal.io → Namespaces (API key auth)
TEMPORAL_ADDRESS=<namespace-name>.<account-id>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=t<namespace-name>.<account-id>
TEMPORAL_API_KEY=api-key

# AWS credentials for Bedrock, Bedrock API key required only when workers are running locally   
AWS_REGION=us-west-2
AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key

# Optional: AWS profile name if using SSO / named profiles
# AWS_PROFILE=my-sso-profile